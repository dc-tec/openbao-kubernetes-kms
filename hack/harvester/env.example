# Source this file from the repository root, then override values for your lab.

export KUBECONFIG="${PWD}/kubeconfig.yaml"
export HARVESTER_RELEASE="openbao-kms-lab"
export HARVESTER_NAMESPACE="default"
export HARVESTER_NETWORK_NAME="default/vm4000"
export HARVESTER_IMAGE_NAMESPACE="default"
export HARVESTER_IMAGE_NAME="REPLACE_WITH_HARVESTER_IMAGE_NAME"
export HARVESTER_SSH_USER="ubuntu"
export SSH_PUBLIC_KEY_FILE="${HOME}/.ssh/id_ed25519.pub"
export SSH_PRIVATE_KEY_FILE="${HOME}/.ssh/id_ed25519"
export HARVESTER_VALUES="${PWD}/hack/harvester/values.local.yaml"
export HARVESTER_INSECURE_SKIP_TLS_VERIFY="false"
export KUBEADM_INSTALL_CNI="true"

# Optional local-only production topology. This adds three extra kubeadm
# control-plane VMs and enables the destructive multi-control-plane recovery
# gate. Keep disabled for the smaller default systemd/static-pod lab.
export HARVESTER_ENABLE_MULTI_CONTROL_PLANE="false"
export HARVESTER_MCP_HOSTS="obk-kubeadm-mcp-1 obk-kubeadm-mcp-2 obk-kubeadm-mcp-3"
