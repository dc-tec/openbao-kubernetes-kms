configVersion: v1alpha1
server:
  socketPath: /run/openbao-kms/kms.sock
  socketMode: "0660"
  socketGroup: "1234"
  metricsAddress: "0.0.0.0:8081"
  healthAddress: "0.0.0.0:8082"
  maxConcurrentStatus: 16
  maxConcurrentEncrypt: 32
  maxConcurrentDecrypt: 64
openbao:
  address: https://openbao:8200
  namespace: ""
  caCertFile: /etc/openbao-kms/tls/openbao-ca.pem
  tlsServerName: localhost
  timeout: 5s
  instanceId: openbao-dev-env
auth:
  method: jwt
  loginBeforeTokenExpiry: 5m
  tokenRenewalIncrement: 1h
  loginTimeout: 0s
  jwt:
    source: oauth2
    mountPath: auth/kind-dev-jwt
    role: openbao-kms-control-plane
    minRemainingTtl: 2m
    clockSkewLeeway: 30s
    expectedIssuer: "{{KEYCLOAK_ISSUER}}"
    expectedAudience:
      - "{{JWT_AUDIENCE}}"
    expectedSubject: "{{KEYCLOAK_SUBJECT}}"
    oauth2:
      tokenUrl: "{{KEYCLOAK_ISSUER}}/protocol/openid-connect/token"
      clientId: "{{KEYCLOAK_CLIENT_ID}}"
      authMethod: client_secret_basic
      clientSecretFile: /etc/openbao-kms/credentials/client-secret
      caCertFile: /etc/openbao-kms/issuer/ca.pem
transit:
  mountPath: transit
  keyName: k8s-kind-dev-etcd
  keyIdScope:
    providerName: openbao-kms-dev-env
    clusterId: kind-dev-env
    transitMountId: transit-kind-dev
    keyLineageId: "{{KEY_LINEAGE_ID}}"
bootstrap:
  graceTimeout: 60s
  retryInterval: 5s
status:
  probeInterval: 5s
  deepProbeInterval: 1m
  statusMaxStaleness: 2m
state:
  path: /var/lib/openbao-kms/state/key-registry.json
rotation:
  mode: observed
  activationDelay: 10s
  requireStableObservationCount: 1
  rejectVersionRollback: true
logging:
  level: info
  format: json
  logOpenBaoRequestIDs: true
  debugCorrelation:
    enabled: false
    ttl: 15m
    incidentId: ""
