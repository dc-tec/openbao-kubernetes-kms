configVersion: v1alpha1
server:
  socketPath: "${socket_path}"
  socketMode: "0660"
  socketGroup: "${socket_group}"
  metricsAddress: "${metrics_address}"
  healthAddress: "${health_address}"
  adminAddress: ""
  unsafeDebugEndpoints: false
openbao:
  address: "${openbao_address}"
  namespace: "${openbao_namespace}"
  caCertFile: "${openbao_ca_file}"
  tlsServerName: "${openbao_tls_name}"
  timeout: 2s
  instanceId: "${openbao_instance_id}"
auth:
  method: jwt
  mountPath: "${auth_mount_path}"
  role: "${auth_role}"
  jwtFile: "${jwt_file}"
  minJwtRemainingTtl: 2m
  clockSkewLeeway: 30s
  loginBeforeTokenExpiry: 5m
  tokenStorage: memory
transit:
  mountPath: "${transit_mount_path}"
  keyName: "${transit_key_name}"
  keyIdScope:
    providerName: "${provider_name}"
    clusterId: "${cluster_id}"
    transitMountId: "${transit_mount_id}"
    keyLineageId: "${transit_key_lineage}"
  useAssociatedData: true
status:
  probeInterval: 30s
  deepProbeInterval: 5m
  statusMaxStaleness: 2m
state:
  path: "${state_path}"
rotation:
  mode: observed
  activationDelay: 2m
  requireStableObservationCount: 3
  rejectVersionRollback: true
performance:
  decryptMicroBatching:
    enabled: false
    maxBatchSize: 32
    maxWait: 2ms
logging:
  level: info
  format: json
  redactOpenBaoPaths: true
  logOpenBaoRequestIDs: true
  debugCorrelation:
    enabled: false
    ttl: 15m
    incidentId: ""
